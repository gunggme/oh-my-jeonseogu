    "@mariozechner/pi-coding-agent": "^0.73.1",
    "undici": "^7.19.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
