{
 "name": "oh-my-jeonseogu",
  "version": "0.2.0",
  "description": "전서구 말투에서 영감을 받은, pi TUI 하네스 위에서 도는 대화 CLI",
  "type": "module",
  "license": "MIT",
  "author": "gunggme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gunggme/oh-my-jeonseogu.git"
  },
  "bugs": "https://github.com/gunggme/oh-my-jeonseogu/issues",
  "homepage": "https://github.com/gunggme/oh-my-jeonseogu#readme",
  "keywords": ["cli", "chat", "llm", "pi", "jeonseogu"],
  "bin": {
